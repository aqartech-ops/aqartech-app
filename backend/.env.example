# Copy this file to .env and fill the values. NEVER commit .env.

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aqartech?schema=public"

# Auth — use a long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
# Comma-separated list of allowed app origins; empty = allow all (development only)
CORS_ORIGINS=""

# First platform admin (created by: npm run db:seed)
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL="admin@aqartech.om"
ADMIN_PASSWORD=""

# 1 = also create a demo company (demo@aqartech.test / Demo@12345) with an active subscription
SEED_DEMO=1

# Email (forgot-password codes, later: receipts & statements).
# Leave SMTP_HOST empty during development: emails are PRINTED in this server's terminal instead.
# No domain yet? A Gmail account works: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=<a Google "App password" (needs 2-step verification)>
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AqarTech <no-reply@aqartech.om>"
