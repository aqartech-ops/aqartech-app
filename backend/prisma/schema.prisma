// AqarTech — the ONLY Prisma schema of the project.
// Rules (see docs/PROJECT.md and CLAUDE.md):
//   * Money is stored as Int in baisa (1 OMR = 1000 baisa). Never Float.
//   * Every company-owned row carries companyId.
//   * Normal records use soft delete (deletedAt) so they can be restored from the trash.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. PLATFORM (فريق إدارة المنصة)
// ==========================================

model PlatformAdmin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  passwordChangedAt DateTime? // sessions issued before this are rejected
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ==========================================
// 2. PLANS & SUBSCRIPTIONS (الباقات والاشتراكات)
// Everything here is editable by platform admins — nothing is hard-coded in code.
// ==========================================

enum PlanAudience {
  COMPANY
  INDIVIDUAL
  ANY
}

model Plan {
  id           String       @id @default(uuid())
  code         String       @unique // stable key, e.g. "pro"
  nameEn       String
  nameAr       String
  descriptionEn String?
  descriptionAr String?
  audience     PlanAudience @default(ANY)
  priceMonthly Int          @default(0) // baisa
  priceYearly  Int          @default(0) // baisa
  // { "properties": 10, "units": 100, "users": 5, "owners": 20 } — null/missing = unlimited
  limits       Json         @default("{}")
  // section keys this plan unlocks, e.g. ["dashboard","properties","financials"]
  features     String[]
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING // registered, waiting for activation (manual for now, payment later)
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id           String             @id @default(uuid())
  companyId    String             @unique
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(PENDING)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// ==========================================
// 3. SUBSCRIBERS (المشتركون: شركة أو مالك فرد)
// ==========================================

enum AccountType {
  COMPANY
  INDIVIDUAL
}

model Company {
  id          String      @id @default(uuid())
  type        AccountType @default(COMPANY)
  name        String
  ownerName   String?
  email       String?
  phone       String?
  logo        String?
  locale      String      @default("en")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  subscription Subscription?
  users        User[]
  roles        Role[]
  activity     ActivityLog[]
  properties   Property[]
  units        Unit[]
  owners       Owner[]
  agreements   ManagementAgreement[]
  partners     PropertyPartner[]
  tenants      Tenant[]
  leases       Lease[]
}

// ==========================================
// 4. USERS, ROLES & PERMISSIONS (المستخدمون والصلاحيات)
// ==========================================

enum UserKind {
  STAFF // company employee
  OWNER // property owner linked to the company — read-only portal
}

model User {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind           UserKind  @default(STAFF)
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  passwordChangedAt DateTime? // sessions issued before this are rejected
  isCompanyAdmin Boolean   @default(false) // the subscriber's main account: full access
  roleId         String?
  role           Role?     @relation(fields: [roleId], references: [id])
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  resetCodes PasswordResetCode[]

  @@index([companyId])
}

/// One-time code for "forgot password" (رمز استعادة كلمة المرور). Only a hash is stored.
model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Role {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  // { "<sectionKey>": "EDIT" | "VIEW" | "HIDDEN" }
  permissions Json      @default("{}")
  // property ids this role is limited to; empty = all properties
  propertyIds String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users User[]

  @@index([companyId])
}

// ==========================================
// 5. ACTIVITY LOG (سجل النشاط: من غيّر ماذا ومتى)
// ==========================================

enum ActorType {
  PLATFORM_ADMIN
  USER
  SYSTEM
}

model ActivityLog {
  id        String    @id @default(uuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorType ActorType
  actorId   String?
  action    String // e.g. "user.create", "auth.login"
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([companyId, createdAt])
}

// ==========================================
// 6. PROPERTIES & UNITS (العقارات والوحدات) — phase 3
// ==========================================

enum PropertyOwnership {
  OWNED // owned by the subscriber itself
  MANAGED // managed on behalf of an owner (management agreement — next batch)
}

enum PropertyCategory {
  BUILDING
  VILLA_COMPOUND
  VILLA
  COMMERCIAL_COMPLEX
  LAND
  OTHER
}

model Property {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  ownership      PropertyOwnership @default(OWNED)
  category       PropertyCategory  @default(BUILDING)
  governorate    String?
  wilayat        String?
  address        String?
  plotNumber     String? // رقم القطعة / الملكية
  floors         Int?
  image          String?
  propertyValue  BigInt? // baisa — for Cap Rate (BigInt: values can exceed 2.1M OMR)
  investmentCost BigInt? // baisa — for ROI
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  units      Unit[]
  agreements ManagementAgreement[]
  partners   PropertyPartner[]
  leases     Lease[]

  @@index([companyId])
}

enum UnitType {
  APARTMENT
  STUDIO
  VILLA
  ROOM
  SHOP
  OFFICE
  WAREHOUSE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model Unit {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number           String
  floor            String?
  type             UnitType   @default(APARTMENT)
  area             Float? // m² (not money)
  bedrooms         Int?
  bathrooms        Int?
  askingRent       Int        @default(0) // baisa per month
  status           UnitStatus @default(VACANT)
  vacantSince      DateTime?
  electricityMeter String?
  waterMeter       String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  leases Lease[]

  @@index([companyId])
  @@index([propertyId])
}

// ==========================================
// 7. OWNERS, MANAGEMENT AGREEMENTS & PARTNERS (الملاك وعقود الإدارة والشركاء) — phase 3
// ==========================================

enum PartyType {
  INDIVIDUAL
  COMPANY
}

model Owner {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          PartyType @default(INDIVIDUAL)
  name          String
  civilId       String? // الرقم المدني
  crNumber      String? // السجل التجاري
  nationality   String?
  phone         String?
  email         String?
  bankName      String?
  accountName   String?
  accountNumber String? // IBAN / account no. — where owner payouts go
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  agreements ManagementAgreement[]
  partners   PropertyPartner[]

  @@index([companyId])
}

enum FeeMethod {
  PERCENT_OF_COLLECTED // % of rent actually collected (default)
  PERCENT_OF_DUE // % of rent due (billed), collected or not
  FIXED // fixed amount per statement period
}

enum StatementPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AgreementStatus {
  ACTIVE
  ENDED
}

/// Agreement between the subscriber (manager) and the owner of a MANAGED property.
model ManagementAgreement {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           Owner           @relation(fields: [ownerId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  feeMethod       FeeMethod       @default(PERCENT_OF_COLLECTED)
  feeRateBp       Int? // basis points: 500 = 5%
  feeFixed        Int? // baisa per statement period
  statementPeriod StatementPeriod @default(MONTHLY)
  status          AgreementStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId])
  @@index([propertyId])
}

/// Who owns what share of a property. Shares are basis points and add up to 10000 (100%).
model PropertyPartner {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id])
  shareBp    Int
  createdAt  DateTime @default(now())

  @@unique([propertyId, ownerId])
  @@index([companyId])
}

// ==========================================
// 8. TENANTS (المستأجرون) — phase 3. A record only: tenants do not sign in.
// ==========================================

model Tenant {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type             PartyType @default(INDIVIDUAL)
  name             String
  civilId          String? // الرقم المدني / رقم الإقامة
  idExpiry         DateTime? // expiry of the civil/resident card
  crNumber         String? // السجل التجاري (company tenants)
  nationality      String?
  phone            String? // WhatsApp
  phone2           String?
  email            String?
  employer         String? // جهة العمل
  guarantorName    String? // الكفيل / الضامن
  guarantorPhone   String?
  guarantorCivilId String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  leases Lease[]

  @@index([companyId])
}

// ==========================================
// 9. LEASES (العقود) — phase 3
// The rent schedule is derived from the lease (see leases/schedule.ts); phase 4 posts it to the ledger.
// ==========================================

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED // reached its end date
  TERMINATED // ended early
  RENEWED // replaced by a renewal lease
}

enum RenewalStatus {
  PENDING
  RENEW
  NOT_RENEW
  NEGOTIATING
}

model Lease {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number            String // L-2026-0001
  propertyId        String
  property          Property         @relation(fields: [propertyId], references: [id])
  unitId            String
  unit              Unit             @relation(fields: [unitId], references: [id])
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  startDate         DateTime
  endDate           DateTime
  monthlyRent       Int // baisa
  discount          Int              @default(0) // baisa per month (تنازل/خصم)
  paymentFrequency  PaymentFrequency @default(MONTHLY)
  dueDay            Int              @default(1) // day of month the installment is due (1-28)
  deposit           Int              @default(0) // baisa — a liability, never income
  municipalityNo    String?
  municipalityFee   Int? // baisa
  status            LeaseStatus      @default(DRAFT)
  renewalStatus     RenewalStatus    @default(PENDING)
  renewedFromId     String?
  terminatedAt      DateTime?
  terminationReason String?
  notes             String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([unitId])
  @@index([tenantId])
}
