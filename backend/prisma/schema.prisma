// AqarTech — the ONLY Prisma schema of the project.
// Rules (see docs/PROJECT.md and CLAUDE.md):
//   * Money is stored as Int in baisa (1 OMR = 1000 baisa). Never Float.
//   * Every company-owned row carries companyId.
//   * Normal records use soft delete (deletedAt) so they can be restored from the trash.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. PLATFORM (فريق إدارة المنصة)
// ==========================================

model PlatformAdmin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  passwordChangedAt DateTime? // sessions issued before this are rejected
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ==========================================
// 2. PLANS & SUBSCRIPTIONS (الباقات والاشتراكات)
// Everything here is editable by platform admins — nothing is hard-coded in code.
// ==========================================

enum PlanAudience {
  COMPANY
  INDIVIDUAL
  ANY
}

model Plan {
  id           String       @id @default(uuid())
  code         String       @unique // stable key, e.g. "pro"
  nameEn       String
  nameAr       String
  descriptionEn String?
  descriptionAr String?
  audience     PlanAudience @default(ANY)
  priceMonthly Int          @default(0) // baisa
  priceYearly  Int          @default(0) // baisa
  // { "properties": 10, "units": 100, "users": 5, "owners": 20 } — null/missing = unlimited
  limits       Json         @default("{}")
  // section keys this plan unlocks, e.g. ["dashboard","properties","financials"]
  features     String[]
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING // registered, waiting for activation (manual for now, payment later)
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id           String             @id @default(uuid())
  companyId    String             @unique
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(PENDING)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// ==========================================
// 3. SUBSCRIBERS (المشتركون: شركة أو مالك فرد)
// ==========================================

enum AccountType {
  COMPANY
  INDIVIDUAL
}

model Company {
  id          String      @id @default(uuid())
  type        AccountType @default(COMPANY)
  name        String
  ownerName   String?
  email       String?
  phone       String?
  logo        String?
  locale      String      @default("en")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  subscription Subscription?
  users        User[]
  roles        Role[]
  activity     ActivityLog[]
  properties   Property[]
  units        Unit[]
  owners       Owner[]
  agreements   ManagementAgreement[]
  partners     PropertyPartner[]
  tenants      Tenant[]
  leases       Lease[]
  journal      JournalEntry[]
  journalLines JournalLine[]
  charges      RentCharge[]
  payments     Payment[]
  cheques      Cheque[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  vendors           Vendor[]
  workOrders        WorkOrder[]
  ownerStatements   OwnerStatement[]
  ownerPayouts      OwnerPayout[]
  counters     Counter[]
}

// ==========================================
// 4. USERS, ROLES & PERMISSIONS (المستخدمون والصلاحيات)
// ==========================================

enum UserKind {
  STAFF // company employee
  OWNER // property owner linked to the company — read-only portal
}

model User {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind           UserKind  @default(STAFF)
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  passwordChangedAt DateTime? // sessions issued before this are rejected
  isCompanyAdmin Boolean   @default(false) // the subscriber's main account: full access
  roleId         String?
  role           Role?     @relation(fields: [roleId], references: [id])
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  resetCodes PasswordResetCode[]

  @@index([companyId])
}

/// One-time code for "forgot password" (رمز استعادة كلمة المرور). Only a hash is stored.
model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Role {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  // { "<sectionKey>": "EDIT" | "VIEW" | "HIDDEN" }
  permissions Json      @default("{}")
  // property ids this role is limited to; empty = all properties
  propertyIds String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users User[]

  @@index([companyId])
}

// ==========================================
// 5. ACTIVITY LOG (سجل النشاط: من غيّر ماذا ومتى)
// ==========================================

enum ActorType {
  PLATFORM_ADMIN
  USER
  SYSTEM
}

model ActivityLog {
  id        String    @id @default(uuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorType ActorType
  actorId   String?
  action    String // e.g. "user.create", "auth.login"
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([companyId, createdAt])
}

// ==========================================
// 6. PROPERTIES & UNITS (العقارات والوحدات) — phase 3
// ==========================================

enum PropertyOwnership {
  OWNED // owned by the subscriber itself
  MANAGED // managed on behalf of an owner (management agreement — next batch)
}

enum PropertyCategory {
  BUILDING
  VILLA_COMPOUND
  VILLA
  COMMERCIAL_COMPLEX
  LAND
  OTHER
}

model Property {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  ownership      PropertyOwnership @default(OWNED)
  category       PropertyCategory  @default(BUILDING)
  governorate    String?
  wilayat        String?
  address        String?
  plotNumber     String? // رقم القطعة / الملكية
  floors         Int?
  image          String?
  propertyValue  BigInt? // baisa — for Cap Rate (BigInt: values can exceed 2.1M OMR)
  investmentCost BigInt? // baisa — for ROI
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  units      Unit[]
  agreements ManagementAgreement[]
  partners   PropertyPartner[]
  leases     Lease[]
  charges    RentCharge[]
  expenses   Expense[]
  workOrders WorkOrder[]
  ownerStatements OwnerStatement[]

  @@index([companyId])
}

enum UnitType {
  APARTMENT
  STUDIO
  VILLA
  ROOM
  SHOP
  OFFICE
  WAREHOUSE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model Unit {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number           String
  floor            String?
  type             UnitType   @default(APARTMENT)
  area             Float? // m² (not money)
  bedrooms         Int?
  bathrooms        Int?
  askingRent       Int        @default(0) // baisa per month
  status           UnitStatus @default(VACANT)
  vacantSince      DateTime?
  electricityMeter String?
  waterMeter       String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  leases Lease[]
  charges RentCharge[]
  expenses   Expense[]
  workOrders WorkOrder[]

  @@index([companyId])
  @@index([propertyId])
}

// ==========================================
// 7. OWNERS, MANAGEMENT AGREEMENTS & PARTNERS (الملاك وعقود الإدارة والشركاء) — phase 3
// ==========================================

enum PartyType {
  INDIVIDUAL
  COMPANY
}

model Owner {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          PartyType @default(INDIVIDUAL)
  name          String
  civilId       String? // الرقم المدني
  crNumber      String? // السجل التجاري
  nationality   String?
  phone         String?
  email         String?
  bankName      String?
  accountName   String?
  accountNumber String? // IBAN / account no. — where owner payouts go
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  agreements ManagementAgreement[]
  partners   PropertyPartner[]
  statements OwnerStatement[]
  payouts    OwnerPayout[]

  @@index([companyId])
}

enum FeeMethod {
  PERCENT_OF_COLLECTED // % of rent actually collected (default)
  PERCENT_OF_DUE // % of rent due (billed), collected or not
  FIXED // fixed amount per statement period
}

enum StatementPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum AgreementStatus {
  ACTIVE
  ENDED
}

/// Agreement between the subscriber (manager) and the owner of a MANAGED property.
model ManagementAgreement {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           Owner           @relation(fields: [ownerId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  feeMethod       FeeMethod       @default(PERCENT_OF_COLLECTED)
  feeRateBp       Int? // basis points: 500 = 5%
  feeFixed        Int? // baisa per statement period
  statementPeriod StatementPeriod @default(MONTHLY)
  status          AgreementStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId])
  @@index([propertyId])
}

/// Who owns what share of a property. Shares are basis points and add up to 10000 (100%).
model PropertyPartner {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id])
  shareBp    Int
  createdAt  DateTime @default(now())

  @@unique([propertyId, ownerId])
  @@index([companyId])
}

// ==========================================
// 8. TENANTS (المستأجرون) — phase 3. A record only: tenants do not sign in.
// ==========================================

model Tenant {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type             PartyType @default(INDIVIDUAL)
  name             String
  civilId          String? // الرقم المدني / رقم الإقامة
  idExpiry         DateTime? // expiry of the civil/resident card
  crNumber         String? // السجل التجاري (company tenants)
  nationality      String?
  phone            String? // WhatsApp
  phone2           String?
  email            String?
  employer         String? // جهة العمل
  guarantorName    String? // الكفيل / الضامن
  guarantorPhone   String?
  guarantorCivilId String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  leases Lease[]
  charges RentCharge[]
  payments Payment[]
  cheques  Cheque[]

  @@index([companyId])
}

// ==========================================
// 9. LEASES (العقود) — phase 3
// The rent schedule is derived from the lease (see leases/schedule.ts); phase 4 posts it to the ledger.
// ==========================================

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED // reached its end date
  TERMINATED // ended early
  RENEWED // replaced by a renewal lease
}

enum RenewalStatus {
  PENDING
  RENEW
  NOT_RENEW
  NEGOTIATING
}

model Lease {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number            String // L-2026-0001
  propertyId        String
  property          Property         @relation(fields: [propertyId], references: [id])
  unitId            String
  unit              Unit             @relation(fields: [unitId], references: [id])
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  startDate         DateTime
  endDate           DateTime
  monthlyRent       Int // baisa
  discount          Int              @default(0) // baisa per month (تنازل/خصم)
  paymentFrequency  PaymentFrequency @default(MONTHLY)
  dueDay            Int              @default(1) // day of month the installment is due (1-28)
  deposit           Int              @default(0) // baisa — a liability, never income
  municipalityNo    String?
  municipalityFee   Int? // baisa
  status            LeaseStatus      @default(DRAFT)
  renewalStatus     RenewalStatus    @default(PENDING)
  renewedFromId     String?
  terminatedAt      DateTime?
  terminationReason String?
  notes             String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  charges  RentCharge[]
  payments Payment[]
  cheques  Cheque[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([unitId])
  @@index([tenantId])
}

// ==========================================
// 9. FINANCE (المالية) — phase 4
// ==========================================
// Every money movement is ONE journal entry made of lines whose amounts sum to zero
// (double entry: + = debit, − = credit, integer baisa). Balances and reports are computed
// from lines only. Entries are never edited or deleted: a correction is a REVERSAL entry.

enum LedgerAccount {
  CASH // الصندوق
  BANK // البنك
  CHEQUES_ON_HAND // شيكات مستلمة لم تُحصّل
  TENANT_RECEIVABLE // ذمم المستأجرين
  SECURITY_DEPOSITS // تأمينات المستأجرين (التزام — ليست إيراداً)
  RENT_INCOME // إيراد الإيجار
  OTHER_INCOME // إيرادات أخرى
  MGMT_FEE_INCOME // عمولة الإدارة
  OWNER_PAYABLE // مستحقات الملاك
  EXPENSES // المصروفات
  OWNER_SHARE // حصة الملاك من صافي العقارات المُدارة (تُقيد عند إصدار كشف المالك)
}

enum EntryType {
  RENT_CHARGE // استحقاق إيجار
  DEPOSIT_CHARGE // استحقاق تأمين
  PAYMENT // تحصيل
  DEPOSIT_REFUND // رد تأمين
  EXPENSE // مصروف
  OWNER_PAYOUT // تحويل للمالك
  MANUAL // قيد يدوي
  REVERSAL // قيد عكسي
  CHEQUE_CLEARED // تحصيل شيك في البنك
  FEE_CHARGE // رسوم على المستأجر
  OWNER_STATEMENT // إصدار كشف حساب مالك
}

model JournalEntry {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String // J-2026-000001
  date        DateTime // accounting date
  type        EntryType
  memo        String?
  leaseId     String?
  chargeId    String?
  reversesId  String?       @unique // set on a REVERSAL entry
  reverses    JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy  JournalEntry? @relation("Reversal")
  createdById String?
  createdAt   DateTime      @default(now())

  lines JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([leaseId])
}

model JournalLine {
  id         String        @id @default(uuid())
  entryId    String
  entry      JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account    LedgerAccount
  amount     Int // baisa: + debit, − credit
  propertyId String?
  unitId     String?
  leaseId    String?
  tenantId   String?
  ownerId    String?

  @@index([companyId, account])
  @@index([tenantId])
  @@index([leaseId])
  @@index([propertyId])
}

enum ChargeKind {
  RENT
  DEPOSIT
  FEE // e.g. bounced-cheque fee (رسوم شيك مرتجع) — other income
}

enum ChargeStatus {
  SCHEDULED // not due yet — no journal entry
  POSTED // due: entry posted (receivable)
  CANCELLED // lease ended early before this period
}

/// Rent schedule (جدول الاستحقاقات) saved when a lease is activated. Posted to the ledger on its due date.
model RentCharge {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaseId     String
  lease       Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id])
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id])
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  kind        ChargeKind   @default(RENT)
  index       Int // installment number (deposit = 0)
  periodStart DateTime?
  periodEnd   DateTime?
  dueDate     DateTime
  amount      Int // baisa
  status      ChargeStatus @default(SCHEDULED)
  entryId     String? // the posting entry
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([leaseId, kind, index])
  @@index([companyId, status, dueDate])
  @@index([tenantId])
}

/// Sequential numbers per company (journal entries, later receipts) — safe under concurrent requests.
model Counter {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String // e.g. "journal:2026"
  value     Int     @default(0)

  @@id([companyId, key])
}

enum PaymentMethod {
  CASH // نقداً
  BANK_TRANSFER // تحويل بنكي
  CHEQUE // شيك (حالي — الشيكات المؤجلة في قسم الشيكات)
  CARD // بطاقة
  ONLINE // دفع إلكتروني
}

enum PaymentStatus {
  POSTED
  VOIDED // cancelled with a reversing entry — never deleted
}

/// A collection from a tenant (تحصيل) and its receipt (إيصال قبض). Always tied to one lease so the
/// money is attributed to the right property and owner.
model Payment {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String // receipt number R-2026-000001
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  leaseId     String
  lease       Lease         @relation(fields: [leaseId], references: [id])
  propertyId  String
  unitId      String
  date        DateTime
  amount      Int // baisa
  method      PaymentMethod
  reference   String? // transfer / card reference
  bankName    String?
  chequeNo    String?
  chequeDate  DateTime?
  notes       String?
  status      PaymentStatus @default(POSTED)
  entryId     String?
  voidedAt    DateTime?
  voidReason  String?
  voidEntryId String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cheque Cheque?

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([tenantId])
  @@index([leaseId])
}

enum ChequeStatus {
  RECEIVED // مستلم (مؤجل) — kept, the tenant is NOT credited yet
  UNDER_COLLECTION // تحت التحصيل — accepted/deposited: tenant credited (receipt issued), waiting for the bank
  CLEARED // محصّل — the money is in the bank
  BOUNCED // مرتجع — the receipt is voided (reversing entry), optional fee charged
  CANCELLED // ملغى / أُعيد للمستأجر before deposit
}

/// Cheques (الشيكات), including post-dated cheques collected when a lease is signed.
model Cheque {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  leaseId      String
  lease        Lease        @relation(fields: [leaseId], references: [id])
  propertyId   String
  unitId       String
  chargeId     String? // the installment this cheque is meant for (informational)
  number       String // cheque number
  bankName     String
  drawer       String? // account holder (if not the tenant)
  amount       Int // baisa
  dueDate      DateTime // date written on the cheque
  status       ChequeStatus @default(RECEIVED)
  paymentId    String?      @unique
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  depositedAt  DateTime?
  clearedAt    DateTime?
  clearEntryId String?
  bouncedAt    DateTime?
  bounceReason String?
  bounceFee    Int? // baisa
  feeChargeId  String?
  cancelledAt  DateTime?
  cancelReason String?
  notes        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId, status, dueDate])
  @@index([tenantId])
  @@index([leaseId])
}

// ==========================================
// 10. EXPENSES & MAINTENANCE (المصروفات والصيانة)
// ==========================================

/// Who bears a cost: the owner (deducted in the owner statement), the company, or the tenant (charged back to the lease).
enum CostBearer {
  OWNER
  COMPANY
  TENANT
}

enum PaidFrom {
  CASH
  BANK
}

enum ExpenseStatus {
  POSTED
  VOIDED // cancelled with a reversing entry — never deleted
}

/// Expense items (بنود المصروفات) — each company edits its own list; defaults are created on first use.
model ExpenseCategory {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nameAr        String
  nameEn        String
  isMaintenance Boolean  @default(false) // used by default when a work order is closed with a cost
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses Expense[]

  @@index([companyId])
}

/// Contractors and suppliers (المقاولون والموردون).
model Vendor {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  specialty String? // plumbing, electrical, AC…
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expenses   Expense[]
  workOrders WorkOrder[]

  @@index([companyId])
}

model Expense {
  id               String          @id @default(uuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number           String // EX-2026-000001
  date             DateTime
  amount           Int // baisa
  categoryId       String
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  propertyId       String? // null = company overhead
  property         Property?       @relation(fields: [propertyId], references: [id])
  unitId           String?
  unit             Unit?           @relation(fields: [unitId], references: [id])
  leaseId          String? // when the tenant bears it
  vendorId         String?
  vendor           Vendor?         @relation(fields: [vendorId], references: [id])
  bearer           CostBearer
  paidFrom         PaidFrom
  description      String
  invoiceNo        String?
  status           ExpenseStatus   @default(POSTED)
  entryId          String?
  rechargeChargeId String? // the FEE charge billed to the tenant
  workOrderId      String?         @unique
  workOrder        WorkOrder?      @relation(fields: [workOrderId], references: [id])
  voidedAt         DateTime?
  voidReason       String?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([propertyId])
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Maintenance work orders (أوامر الصيانة). Closing one with a cost creates the expense automatically.
model WorkOrder {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number        String // WO-2026-0001
  propertyId    String
  property      Property          @relation(fields: [propertyId], references: [id])
  unitId        String? // null = common area
  unit          Unit?             @relation(fields: [unitId], references: [id])
  title         String
  description   String?
  priority      WorkOrderPriority @default(NORMAL)
  status        WorkOrderStatus   @default(OPEN)
  vendorId      String?
  vendor        Vendor?           @relation(fields: [vendorId], references: [id])
  bearer        CostBearer
  estimatedCost Int? // baisa
  reportedBy    String?
  scheduledDate DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelReason  String?
  notes         String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  expense Expense?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([propertyId])
}

// ==========================================
// 11. OWNER STATEMENTS & PAYOUTS (كشوف الملاك والتحويلات)
// ==========================================

enum DocStatus {
  ISSUED
  VOIDED // cancelled with a reversing entry — never deleted
}

/// Owner statement of a managed property for a period: rent collected − owner expenses − management fee = net,
/// split between the partners. Issuing posts: Dr owner share / Cr management fee income / Cr owed to each owner.
model OwnerStatement {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number        String // OS-2026-0001
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id])
  ownerId       String? // main owner (agreement)
  owner         Owner?    @relation(fields: [ownerId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  rentCollected Int // baisa
  rentDue       Int
  ownerExpenses Int
  feeAmount     Int
  net           Int // can be negative (the owner owes the company)
  details       Json // snapshot: fee rule, expenses list, partner split, per-lease collections
  status        DocStatus @default(ISSUED)
  entryId       String?
  voidedAt      DateTime?
  voidReason    String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@unique([companyId, number])
  @@index([propertyId, periodStart])
}

/// Money transferred to an owner (تحويل للمالك): Dr owed to owners / Cr bank or cash.
model OwnerPayout {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String // OP-2026-0001
  ownerId     String
  owner       Owner     @relation(fields: [ownerId], references: [id])
  propertyId  String? // optional: which property it is for
  date        DateTime
  amount      Int // baisa
  paidFrom    PaidFrom
  reference   String?
  notes       String?
  status      DocStatus @default(ISSUED)
  entryId     String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([companyId, number])
  @@index([ownerId])
}
