// AqarTech — the ONLY Prisma schema of the project.
// Rules (see docs/PROJECT.md and CLAUDE.md):
//   * Money is stored as Int in baisa (1 OMR = 1000 baisa). Never Float.
//   * Every company-owned row carries companyId.
//   * Normal records use soft delete (deletedAt) so they can be restored from the trash.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. PLATFORM (فريق إدارة المنصة)
// ==========================================

model PlatformAdmin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ==========================================
// 2. PLANS & SUBSCRIPTIONS (الباقات والاشتراكات)
// Everything here is editable by platform admins — nothing is hard-coded in code.
// ==========================================

enum PlanAudience {
  COMPANY
  INDIVIDUAL
  ANY
}

model Plan {
  id           String       @id @default(uuid())
  code         String       @unique // stable key, e.g. "pro"
  nameEn       String
  nameAr       String
  descriptionEn String?
  descriptionAr String?
  audience     PlanAudience @default(ANY)
  priceMonthly Int          @default(0) // baisa
  priceYearly  Int          @default(0) // baisa
  // { "properties": 10, "units": 100, "users": 5, "owners": 20 } — null/missing = unlimited
  limits       Json         @default("{}")
  // section keys this plan unlocks, e.g. ["dashboard","properties","financials"]
  features     String[]
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING // registered, waiting for activation (manual for now, payment later)
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id           String             @id @default(uuid())
  companyId    String             @unique
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(PENDING)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// ==========================================
// 3. SUBSCRIBERS (المشتركون: شركة أو مالك فرد)
// ==========================================

enum AccountType {
  COMPANY
  INDIVIDUAL
}

model Company {
  id          String      @id @default(uuid())
  type        AccountType @default(COMPANY)
  name        String
  ownerName   String?
  email       String?
  phone       String?
  logo        String?
  locale      String      @default("en")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  subscription Subscription?
  users        User[]
  roles        Role[]
  activity     ActivityLog[]
}

// ==========================================
// 4. USERS, ROLES & PERMISSIONS (المستخدمون والصلاحيات)
// ==========================================

enum UserKind {
  STAFF // company employee
  OWNER // property owner linked to the company — read-only portal
}

model User {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind           UserKind  @default(STAFF)
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  isCompanyAdmin Boolean   @default(false) // the subscriber's main account: full access
  roleId         String?
  role           Role?     @relation(fields: [roleId], references: [id])
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([companyId])
}

model Role {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  // { "<sectionKey>": "EDIT" | "VIEW" | "HIDDEN" }
  permissions Json      @default("{}")
  // property ids this role is limited to; empty = all properties
  propertyIds String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users User[]

  @@index([companyId])
}

// ==========================================
// 5. ACTIVITY LOG (سجل النشاط: من غيّر ماذا ومتى)
// ==========================================

enum ActorType {
  PLATFORM_ADMIN
  USER
  SYSTEM
}

model ActivityLog {
  id        String    @id @default(uuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorType ActorType
  actorId   String?
  action    String // e.g. "user.create", "auth.login"
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime  @default(now())

  @@index([companyId, createdAt])
}
