# Copy to .env (never commit .env).
# Address of the AqarTech API as seen from the device running the app.
#   Web on the same computer:     http://localhost:3000
#   Phone on the same Wi-Fi:      http://<your-computer-LAN-IP>:3000  (e.g. http://192.168.1.123:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000
