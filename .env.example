# Copy to .env (never commit .env).
#
# During development you normally need NOTHING here: the app finds your computer automatically
# (same address Expo uses for the QR code), even after you switch Wi-Fi networks.
#
# Production builds: the address of the live AqarTech API.
# EXPO_PUBLIC_API_URL=https://api.aqartech.om
#
# Development only — force a specific server instead of auto-detection:
# EXPO_PUBLIC_API_URL=http://192.168.1.123:3000
# EXPO_PUBLIC_API_URL_FORCE=1
#
# API port used by auto-detection (default 3000)
# EXPO_PUBLIC_API_PORT=3000
